# Copy to .env.local and fill in. Next.js loads .env.local automatically;
# the diagnostics harness loads it via `node --env-file-if-exists=.env.local`.

# Google Gemini API key — https://aistudio.google.com/apikey
# Required by /api/roast, /api/compare, and `npm run diag -- replay`.
# Without it, requests fail with a generic error (the key is interpolated into
# the request URL, so an unset value is sent as the literal string "undefined").
GEMINI_API_KEY=
